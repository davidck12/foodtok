DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Optional: enables live Google Reviews on restaurant pages and lets search find
# any real-world restaurant. Needs a Google Cloud project with billing enabled
# and the "Places API (New)" turned on. App works fine without it.
GOOGLE_PLACES_API_KEY=""
