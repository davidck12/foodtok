// Foodtok data model. Postgres-backed (Railway).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  restaurants Restaurant[] @relation("RestaurantOwner")
  reviews     Review[]
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  description String?
  cuisine     String
  address     String
  city        String
  lat         Float
  lng         Float
  priceRange  Int      @default(2)
  coverImage  String?
  createdById String
  createdBy   User     @relation("RestaurantOwner", fields: [createdById], references: [id])
  reviews     Review[]
  createdAt   DateTime @default(now())

  @@index([city])
  @@index([cuisine])
}

model Review {
  id           String     @id @default(cuid())
  rating       Int
  text         String
  photos       String[]   @default([])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, userId])
}
